# Ink Desk — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Both keys are read only by server-side route handlers and the kernel-test
# script. Neither is ever sent to the browser.

# --- Keys -------------------------------------------------------------------

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# --- Models -----------------------------------------------------------------

# Both pinned so an upstream revision can't change the art style or the
# writing voice mid-build. Slice 1 probes both before any UI depends on them.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Image sizes ------------------------------------------------------------
#
# Fixed per surface so art is never cropped through a face. Only the three
# sizes the model offers are valid: 1024x1024, 1536x1024, 1024x1536.
#
# A model sheet is a row of poses, so it is landscape.
# The page is wide / two squares / wide — see spec.md > The Page Layout.

OPENAI_SHEET_SIZE=1536x1024
OPENAI_PANEL_SIZE_WIDE=1536x1024
OPENAI_PANEL_SIZE_SQUARE=1024x1024

# --- Image quality ----------------------------------------------------------
#
# Output cost per image at 1024x1024:
#   low ~$0.006 · medium ~$0.013 · high ~$0.053 · xhigh ~$0.094 · max ~$0.211
#
# Build at low. Switch to max/high only when filming.

OPENAI_SHEET_QUALITY=low
OPENAI_PANEL_QUALITY=low

# Filming values:
#   OPENAI_SHEET_QUALITY=max
#   OPENAI_PANEL_QUALITY=high

# Quality used by scripts/kernel-test.mjs. Deliberately `medium`, not `low`:
# at low quality a drifted face could be the quality rather than the method,
# so the test wouldn't prove anything. ~$0.06 for the whole run.
KERNEL_TEST_QUALITY=medium

# --- Generation limits ------------------------------------------------------

# How many panel images may generate at once. Build tier allows 20 images/min,
# so 2 is margin rather than necessity.
PANEL_CONCURRENCY=2

# A panel still "inking" after this long falls back to the failed state with
# "Try again". Set from the slowest call the kernel test reports.
GENERATION_TIMEOUT_MS=180000
