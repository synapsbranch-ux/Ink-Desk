# Ink Desk — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Both keys stay on this machine: the app's server modules and the kernel-test
# script read both, and the video scripts under video/ read OPENROUTER_API_KEY
# only. Neither is ever sent to the browser.

# --- Keys -------------------------------------------------------------------

# Claude is called on the Anthropic API directly.
# https://console.anthropic.com/settings/keys
# Optional since v2: without it, every text call uses the fallback below.
ANTHROPIC_API_KEY=sk-ant-...

# Images go through OpenRouter, not the OpenAI API — and so does the text
# fallback when Claude can't be used.
# https://openrouter.ai/settings/keys
#
# Keep a balance above $1: OpenRouter returns 402 at or below that, which the
# app maps to "the studio is busy." Plan ~$2 for a full filming run, so ~$2.50
# of balance is the real floor — top up to ~$3 before filming rather than
# discovering the floor on camera.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Models -----------------------------------------------------------------

# The text model is pinned. The image model cannot be: OpenRouter publishes no
# dated snapshot for it, only this alias, so an upstream revision could change
# the art style mid-build. See spec.md > Verified: Image Model and
# Reference-Image Support for what to do if the style shifts.
IMAGE_MODEL=openai/gpt-image-2.5-sunburst
ANTHROPIC_MODEL=claude-sonnet-5-5

# Text fallback (v2). Claude answers first; when it can't be used — no
# ANTHROPIC_API_KEY, a 402, or a 5xx / 529 / 429 that survives one retry — the
# same call goes to this model through OpenRouter with a strict JSON schema,
# and the reply is validated exactly as Claude's is. The terminal names the
# provider that answered; the screen never changes. ~$0.002 per synopsis.
#   auto    (default) Claude first, fallback when Claude can't be used
#   always  skip Claude — rehearse the fallback without blanking the key
#   never   no fallback; Claude's own errors reach the screen as before
LLM_FALLBACK=auto
LLM_FALLBACK_MODEL=openai/gpt-5.6-terra

# --- Image shape ------------------------------------------------------------
#
# OpenRouter takes `aspect_ratio`, NOT `size` — there is no pixel-dimension
# parameter on this model, and `size` is not in its passthrough list. Fixed per
# surface so art is never cropped through a face; the ratio is what the no-crop
# guarantee actually depends on.
#
# Valid for this model: 1:1, 3:2, 2:3, 4:3, 3:4, 16:9, 9:16, 21:9, auto.
#
# A model sheet is a row of poses, so it is landscape.
# The page is wide / two squares / wide — see spec.md > The Page Layout.

IMAGE_SHEET_ASPECT=3:2
IMAGE_PANEL_ASPECT_WIDE=3:2
IMAGE_PANEL_ASPECT_SQUARE=1:1

# The chapter cover (v2) is a portrait, drawn at the panel quality. The title
# is lettered by the app over it — never requested from the model.
IMAGE_COVER_ASPECT=2:3

# --- Image quality ----------------------------------------------------------
#
# Five paid levels: low, medium, high, xhigh, max.
#
# OpenRouter bills images per token, not per image: $30 per million output
# image tokens. MEASURED by the slice 2 kernel test: low 1:1 $0.0060 ·
# medium 1:1 $0.0270 · medium 3:2 $0.0114 to $0.0242. high/xhigh/max are still
# estimates (~$0.07 / ~$0.13 / ~$0.29 at 1:1); lib/cost.ts rounds them up to
# 0.09 / 0.16 / 0.36 so the Director's estimate is never optimistic.
#
# Cost is driven more by how much is IN the picture than by the aspect ratio:
# two 3:2 images at the same quality came back at $0.0114 (plain-background
# model sheet) and $0.0242 (full night skyline), a 2.1x spread. Expect panel
# costs to vary ~2x with scene complexity. The kernel test prints the real
# `usage.cost` on every call — trust that over any table.
#
# Build at low. Switch to high only when filming.

IMAGE_SHEET_QUALITY=low
IMAGE_PANEL_QUALITY=low

# Filming values. v2 films two pages at high, the sheets at high too (not
# max). Budget about $2, the spec's v2 line: 2 sheets + 8 panels + 1 cover
# with a redraw or two, and scenes that cost up to ~2x the table above (the
# bare 11 images come nearer $1; the 2026-10-14 filming run, 15 images with
# a third page and a redraw, came to $0.96).
# The capture (video/capture/record.mts) run with --quality high stops before
# its first paid call unless the app is drawing panels at high.
#   IMAGE_SHEET_QUALITY=high
#   IMAGE_PANEL_QUALITY=high

# Quality used by scripts/kernel-test.mjs. Deliberately `medium`, not `low`:
# at low quality a drifted face could be the quality rather than the method,
# so the test wouldn't prove anything. Roughly $0.08 for the default run,
# $0.13 to $0.14 for a --style-ref or --setting-ref test (measured 2026-10-14).
KERNEL_TEST_QUALITY=medium

# --- Generation limits ------------------------------------------------------

# How many panel images may generate at once. OpenRouter does not publish a
# per-minute image ceiling the way the OpenAI tiers did; spend is capped by the
# balance and by any per-key limit you set. 2 keeps panels landing out of order
# and keeps a 429 off camera. (QUEUE_CONCURRENCY_IMAGE, below, is the v3 name;
# when it is set it wins, and this one is the fallback.)
PANEL_CONCURRENCY=2

# A panel still "inking" after this long falls back to the failed state with
# "Try again". Measured, not guessed: the slowest call in the slice 2 kernel
# test was 118.7s (square close-up at medium). The old 180000 placeholder left
# only 1.5x headroom on a tier below filming quality — a panel that finished
# normally could have been demoted to "failed" on camera. 3x the measured
# worst case.
GENERATION_TIMEOUT_MS=360000

# --- Generation (v3) --------------------------------------------------------
#
# Whether the paid buttons work: true or false. Unset, it is ON in development
# and OFF in production (NODE_ENV=production), so a public deploy cannot spend
# before sign-in and limits exist. Closed, every generate route answers
# "Generation isn't open on this studio yet." before it reads the request.
# GENERATION_ENABLED=

# PANEL_CONCURRENCY (1 to 8) and GENERATION_TIMEOUT_MS (30000 to 900000) above
# are checked when the server starts: a blank one means the default, anything
# else that isn't a whole number in range stops the server with a sentence
# naming it.

# --- The queue and the worker (v3, slice 18) --------------------------------
#
# Generation is a JOB: a record in the store (Mongo, or data/jobs/ on a local
# desk), put on a queue, run by a worker. A page can ink while the web service
# is redeployed, and a job that was paid for is never paid for twice.
#
#   inline   (default outside production) the web process runs the jobs itself;
#            a clone with two API keys still works, and every check runs this
#            way. Jobs do not survive a restart of the server.
#   bullmq   (the only mode in production) the web service queues the job on
#            Redis and a separate `worker` service (`npm run worker`) runs it.
#            Needs REDIS_URL, which Railway's Redis provides — use its private
#            address (redis.railway.internal). Locally: start a Redis, set both
#            of these (REDIS_URL looks like redis://localhost:6379), run `npm run dev` in one terminal and `npm run worker`
#            in another.
# INKDESK_QUEUE=inline
# REDIS_URL=
#
# Worker only. How many image jobs one worker draws at once (1 to 8; blank =
# PANEL_CONCURRENCY, default 2).
# QUEUE_CONCURRENCY_IMAGE=
#
# How many jobs one person may have queued or running at once (1 to 200,
# default 30 — Generate all on a six-page chapter is 25), and how many the
# whole studio will hold (1 to 5000, default 200) before it says it is busy.
# QUEUE_USER_INFLIGHT=30
# QUEUE_MAX_WAITING=200
# (Neither counts, nor refuses, the two jobs that belong to a person rather than
# a picture — Settings' Export my data and Delete my account, which run on their
# own `account` queue, one at a time per worker, with no limit to wait behind.
# They need REDIS_URL and the worker like any other job in bullmq mode.)
#
# A job whose worker found the store unreachable after the picture was paid for
# is run again after this many milliseconds (doubling, up to three runs; 0 to
# 60000, default 5000). The picture is attached, never drawn twice.
# QUEUE_RETRY_BACKOFF_MS=5000
#
# Worker only. When it is told to stop (a deploy), how long it lets what it is
# drawing finish before giving up on it — 0 to 600000, default 90000. On Railway
# set RAILWAY_DEPLOYMENT_DRAINING_SECONDS to about the same, or the platform
# ends the process first; a picture cut off mid-call is drawn, and paid for, again.
# WORKER_GRACE_MS=90000
#
# Image-generation retries after a 429 wait as long as the provider's
# Retry-After asks (at most 20 s), else 1 to 3 s. Set 0 to retry at once.
# IMAGE_RETRY_DELAY_MS=

# --- Accounts and sign-in (v3, slice 19) -----------------------------------
#
# Who may use the studio: INKDESK_AUTH.
#   off    (default outside production) one owner, "local" — a fresh clone,
#          development and every check run this way; no account, no Clerk.
#   clerk  (the default, and the only mode, in production) sign-in through
#          Clerk; every project, image and job belongs to the account that
#          made it, and anyone else gets "There is no such project".
#   test   development and the checks only: the request header
#          x-inkdesk-test-user (user_ followed by letters and digits) names the
#          caller, so two people can be played without Clerk. Production
#          refuses off and test at startup.
# INKDESK_AUTH=off
#
# Clerk mode only. From the Clerk dashboard (API keys). The SDK reads the
# NEXT_PUBLIC_ name; CLERK_PUBLISHABLE_KEY is accepted too and passed
# explicitly. It must be set when the app is BUILT as well as when it runs:
# the Content-Security-Policy that allows Clerk's host is fixed at build time.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# The worker needs this one too (and no other Clerk setting): deleting an account
# deletes its Clerk user, so a worker in clerk mode refuses to start without it.
# Optional: the PEM public key (Clerk dashboard → API keys → JWT public key).
# With it, sessions are verified on this server with no call to Clerk. One
# line with \n between the lines is fine.
# CLERK_JWT_KEY=
# The signing secret of the webhook endpoint https://<your-domain>/api/webhooks/clerk
# (subscribe to user.created, user.updated, user.deleted). Without it the
# endpoint answers 503 and accounts are not recorded.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Sign-in and sign-up live at /sign-in and /sign-up; the app tells Clerk so,
# and these two only matter to Clerk's own components:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
#
# The studio's own address. Sessions are trusted, and requests that change
# something are accepted, only from it (and http://localhost:3000 outside
# production); a request to www.<it> is sent to it. Required in production.
# APP_URL=https://inkdesk.example
# NEXT_PUBLIC_APP_URL=https://inkdesk.example
#
# Shown on /terms and /privacy as the address for deletion requests and
# reports, until Settings and Report arrive. Leave unset to show none.
# CONTACT_EMAIL=

# --- Sharing, reports and admins (v3, slice 21) --------------------------------
#
# Who may open /admin/reports (the reports people file about shared manga, with
# Unpublish and Mark handled): a comma-separated list of the email addresses of
# their accounts, case-insensitive, matched against the VERIFIED email the studio
# recorded for the account — the same way ALLOWLIST_EMAILS is. Blank means nobody
# (the safe default in production). With sign-in off (a local desk) the one
# owner may open it. Anyone else gets the same "no such page" as a mistyped
# address. No email is sent anywhere: reports are read on that page.
# ADMIN_EMAILS=you@example.com
#
# Video (slice 22). Off by default: the dashboard shows no Videos section and no
# route makes one until this is true. Only the exact word true opens it.
# VIDEO_ENABLED=false
#
# What an animated page is made with. Every one of these is optional; a value
# that is not understood stops the server (and the worker) at start with a
# sentence naming it, never the value.
#
#   VIDEO_MODEL          the Seedance model on OpenRouter. Unset: bytedance/seedance-2.0
#                        in production, bytedance/seedance-2.0-fast in development
#                        (the cheap one, about $0.04 a second at 480p).
#   VIDEO_RESOLUTION     480p, 720p or 1080p. Unset: 720p in production, 480p in
#                        development. The finished trailer is 1280x720 either way.
#   VIDEO_MOTION_METHOD  how a panel is handed to Seedance. A: the panel is the
#                        first frame. B: the panel and the character's sheet are
#                        references, and the panel is named as the opening frame.
#                        The default, B, is PROVISIONAL until the motion test in
#                        data/kernel-test/motion/ has been judged; if the faces
#                        drift, set A and nothing else changes.
#   TTS_MODEL            the voice model. Unset: elevenlabs/eleven-v4.
#   MUSIC_MODEL          the music model. Unset: google/lyria-3-clip-preview.
#   VIDEO_FAIL_SHOT      development only, 0 to 3: that panel's FIRST attempt is
#                        refused before anything is submitted or spent, so you can
#                        see a shot fail and press Try again. Ignored in production.
#
# Worker (and the inline queue). How many trailers one worker makes at once
# (1 to 4, default 1 — each trailer already runs its four shots side by side,
# and every shot is paid for), how many shots of one trailer are with the
# provider at once (1 to 4, default 4), how often a shot is asked after (1000 to
# 60000 ms, default 5000) and how long one may take before it is given up on
# (60000 to 1800000 ms, default 720000; the slowest measured took four minutes).
# Together the last two must fit a trailer's 25 minutes: ceil(4 / parallel) ×
# timeout + 3 minutes for the assembly — so with fewer shots at once, a shorter
# timeout (2 at a time: at most 11 minutes each).
# A trailer has a lane of its own (the `video` queue): it never takes a picture's
# place and a page of pictures never waits behind it. The worker service needs
# ffmpeg and ffprobe on its PATH (the web service does not, unless it runs the
# inline queue).
# QUEUE_CONCURRENCY_VIDEO=1
# VIDEO_SHOT_PARALLEL=4
# VIDEO_POLL_MS=5000
# VIDEO_SHOT_TIMEOUT_MS=720000

# --- Limits, quotas and the kill switch (v3, slice 20) ------------------------
#
# Opening the public studio, in order: set ALLOWLIST_EMAILS and the two caps
# below, put a credit limit on the OpenRouter key itself (auto top-up off: the
# backstop beyond every cap here), keep REDIS_URL on web and worker (production
# without it has no counters, so nothing can spend), then GENERATION_ENABLED=true.
#
# Nothing that spends runs without a quota, a rate limit and the kill switch.
# A person's day (UTC, resetting at 00:00) is counted in Redis (REDIS_URL, above;
# an in-process counter on a bare dev desk), and what the header meter and the
# Usage page show is exactly what is enforced. Spend is RESERVED before a
# provider is called (an estimate, held atomically against every cap, so
# parallel clicks cannot over-spend), SETTLED to the provider's real cost when it
# finishes, and RELEASED if it fails.
#
#   on   (default wherever sign-in is on, and in production) enforce everything.
#   off  (default on a local desk with INKDESK_AUTH=off) count nothing, so a
#        fresh clone and every check that predates accounts run untouched.
#        Production refuses off.
# INKDESK_LIMITS=on
#
# Who gets the higher "allowlisted" limits: a comma-separated list of the email
# addresses of their accounts, case-insensitive. Everyone else is on the free
# plan. (The local owner of a desk without sign-in is always allowlisted.)
# ALLOWLIST_EMAILS=you@example.com,friend@example.com
#
# THE KILL SWITCH. The most the studio spends in a UTC day, in dollars, across
# everyone (default 5). When it would be passed, generation pauses for everyone
# with one message until 00:00 UTC; reading, the reader, exports and shares keep
# working. Read on every request, so lowering it in Railway (try 0.01) pauses
# generation at once, and 0 pauses it entirely.
# GLOBAL_DAILY_USD_CAP=5
# An optional ceiling across ALL days, in dollars; unset means none. Once the
# studio has spent this much, generation stays paused until you raise it. Your
# choice: the OpenRouter key's own credit limit (auto top-up off) is the
# backstop beyond this one.
# GLOBAL_TOTAL_USD_CAP=
#
# Daily quotas per plan: pictures, new projects, seconds of video, characters of
# voice. Free: 20, 1, 20, 2000. Allowlisted: 150, 10, 120, 20000.
# QUOTA_FREE_IMAGES=20
# QUOTA_FREE_PROJECTS=1
# QUOTA_FREE_VIDEO_SECONDS=20
# QUOTA_FREE_AUDIO_CHARS=2000
# QUOTA_ALLOW_IMAGES=150
# QUOTA_ALLOW_PROJECTS=10
# QUOTA_ALLOW_VIDEO_SECONDS=120
# QUOTA_ALLOW_AUDIO_CHARS=20000
# What one person may spend in a UTC day, in dollars (free 1, allowlisted 10).
# USER_DAILY_USD_FREE=1
# USER_DAILY_USD_ALLOW=10
#
# Request windows (sliding), per person: paid text calls and paid image
# requests a minute, uploads an hour, every other change a minute, every other
# read a minute; pictures served a minute (a reader page is dozens); signed-out
# callers a minute per client address.
# RATE_TEXT_PER_MIN=10
# RATE_IMAGE_PER_MIN=6
# RATE_UPLOAD_PER_HOUR=20
# RATE_EDIT_PER_MIN=120
# RATE_READ_PER_MIN=240
# RATE_MEDIA_PER_MIN=1200
# RATE_ANON_PER_MIN=60
# The public share page (slice 21), per client address: pictures of a shared
# manga a minute (a reader page is dozens, and a school or office shares one
# address), and reports an hour. The report window refuses when Redis is down
# rather than letting everyone through; the pictures do not.
# RATE_ANON_MEDIA_PER_MIN=600
# RATE_REPORT_PER_HOUR=6
#
# How many proxies in front of the app append to X-Forwarded-For (0 to 5,
# default 1: Railway's edge). The client address a signed-out request is keyed by
# is the entry that many places from the END of the header, which a caller
# cannot write. 0 trusts no header: every signed-out caller shares one window.
# TRUSTED_PROXY_HOPS=1
# Which header names the client address: x-forwarded-for (default; read from the
# right, so what a caller writes is ignored) or x-real-ip. Railway documents
# X-Real-IP as the client's remote IP but not whether its edge overwrites one a
# caller sends; switch only after checking that on the live domain.
# CLIENT_IP_HEADER=x-forwarded-for

# ---------------------------------------------------------------------------
# Storage. Where projects and images live.
#   local (default)  data/projects/<id>/project.json and data/images/ — a clone
#                    runs with nothing but the two API keys. A v1 data/chapter.json
#                    is migrated into a project on the first visit to the desk and
#                    left untouched.
#   cloud            MongoDB (project state, collection `projects`) + S3-compatible
#                    buckets (Cloudflare R2, AWS S3 or MinIO). Needs every
#                    required setting below; a missing or malformed one is
#                    refused by name at startup — never by its value — and the
#                    studio never quietly falls back to the local desk. A cloud
#                    desk starts empty: local projects stay on disk, and the v1
#                    chapter.json is not migrated into the cloud. The buckets
#                    must exist and stay private; images reach the browser only
#                    through /api/image/<id>. Several processes (web and the
#                    worker) may write one database: project writes are
#                    compare-and-set, and the job records say who is drawing.
#                    Variables already exported in your shell win over this
#                    file — if your shell sets DB_* or S3_* for another project,
#                    unset them before running the studio in cloud mode. The
#                    terminal names the database and bucket host it connected to.
INKDESK_STORAGE=local

# Cloud mode only (INKDESK_STORAGE=cloud). Server-side; never in the browser.
#
# Two names are accepted for some settings, so a host that already names them
# its own way needs no renaming. Where both are set, the FIRST name wins:
#
#   Mongo URL             MONGODB_URI, else DB_URL                 required
#   Mongo database        MONGODB_DB, else DB_DATABASE             required
#   project-files bucket  S3_BUCKET_PROJECT_FILES, else S3_BUCKET  required — images and uploads
#   outputs bucket        S3_BUCKET_COMPILE_OUTPUTS, else the project-files bucket
#                                                                  optional — rendered videos and exports
#                         Both buckets are checked at start: the keys need to
#                         read, write AND list (ListBucket) the outputs bucket —
#                         an export, and the deletion of an account, list it.
#   S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY required
#   S3_PUBLIC_ENDPOINT    optional — the host for signed URLs; S3_ENDPOINT if unset
#   S3_FORCE_PATH_STYLE   optional — true (default; R2 and MinIO) or false
#                         (a provider that only takes <bucket>.<host> addresses)
#   S3_KEY_PREFIX         optional — the folder Ink Desk writes under in both
#                         buckets, ending in a slash; inkdesk/ if unset. Never
#                         the root, so a shared bucket keeps Ink Desk to itself.
#
#   Mongo URL    mongodb:// or mongodb+srv:// — e.g. mongodb+srv://<user>:<password>@<cluster>/
#   S3_ENDPOINT  R2: https://<account-id>.r2.cloudflarestorage.com  (S3_REGION=auto)
#                AWS: https://s3.<region>.amazonaws.com · MinIO: http://localhost:9000
MONGODB_URI=
# DB_URL=
MONGODB_DB=
# DB_DATABASE=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET_PROJECT_FILES=
# S3_BUCKET=
S3_BUCKET_COMPILE_OUTPUTS=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_KEY_PREFIX=

# --- The demo video (video/, not the app) ------------------------------------
# The narration voice for `npm run video:narrate`: one of ElevenLabs' premade
# voices through OpenRouter — george, sarah, adam, alice, bella, bill, brian,
# charlie, daniel, jessica, roger, will. No default: hear them first with
# `npm run video:narrate -- --samples` (≈ $0.02 for all twelve). Uses
# OPENROUTER_API_KEY above.
# NARRATION_VOICE=
# Only where Remotion must not download its own headless browser (a sandbox):
# the path of an installed one — exported in the shell, not read from this file:
# INKDESK_BROWSER=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
