{
  "name": "ink-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env --import ./scripts/server-only.mts worker/index.ts",
    "kernel-test": "node scripts/kernel-test.mjs",
    "check:store": "tsx scripts/chapter-store-check.mts",
    "check:cast": "tsx scripts/cast-check.mts",
    "check:page": "tsx scripts/page-check.mts",
    "check:stages": "tsx scripts/stages-check.mts",
    "check:bubble": "tsx scripts/bubble-check.mts",
    "check:repair": "tsx scripts/repair-check.mts",
    "check:export": "tsx scripts/export-check.mts",
    "check:models": "tsx scripts/models-check.mts",
    "check:assets": "tsx scripts/assets-check.mts",
    "check:llm": "tsx scripts/llm-check.mts",
    "check:plan": "tsx scripts/plan-check.mts",
    "check:demo-timeline": "tsx scripts/demo-timeline-check.mts",
    "check:config": "tsx scripts/config-check.mts",
    "check:hardening": "tsx scripts/hardening-check.mts",
    "check:queue": "tsx scripts/queue-check.mts",
    "check:activity": "tsx scripts/activity-check.mts",
    "check:auth": "tsx scripts/auth-check.mts",
    "check:ownership": "tsx scripts/ownership-check.mts",
    "video:capture": "npm --prefix video run capture --",
    "video:narrate": "npm --prefix video run narrate --",
    "video:render": "npm --prefix video run render",
    "video:render:motion": "npm --prefix video run render:motion",
    "video:music": "npm --prefix video run music --",
    "video:music:generate": "npm --prefix video run music:generate --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "3.1151.0",
    "@clerk/nextjs": "7.9.14",
    "bullmq": "6.3.12",
    "ioredis": "5.11.1",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-rnd": "^10.5.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
