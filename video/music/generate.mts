// The demo's music, generated by a music model through OpenRouter — the
// alternative to composing it in code (compose.mts). Google's Lyria 3 answers
// a chat completion with audio: a prompt describing the mood, an mp3 back.
// The result is not deterministic and costs money ($0.08 a song, $0.04 a
// 30 s clip), so every generation is kept under out/music/ and the one in
// use is installed as public/music/track.mp3 with a LICENSE.txt that says
// where it came from — spec.md > The Demo Video Pipeline (v2).
//
//   cd video && npx tsx music/generate.mts [--model google/lyria-3-pro-preview]
//                                          [--prompt music/prompt.txt] [--dry-run]
//   cd video && npx tsx music/generate.mts --install out/music/<file>.mp3
//   npm run video:music:generate            (from the repo root)
//
// Verified 2026-10-14 against the live API: audio output needs `stream: true`
// and `modalities: ['text', 'audio']`; the mp3 arrives base64 in
// `choices[0].delta.audio.data` chunks; `usage.cost` closes the stream.
import { spawnSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import { copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { basename, dirname, join, relative } from 'node:path'
import { fileURLToPath } from 'node:url'
import { parseArgs } from 'node:util'
import { apiKey, MISSING_KEY, providerMessage } from '../openrouter.ts'
import { CUT } from '../src/cut.ts'
import { resolvePlan } from '../src/timeline.ts'

const VIDEO = join(dirname(fileURLToPath(import.meta.url)), '..')
const OUT = join(VIDEO, 'out', 'music')
const PUBLIC_MUSIC = join(VIDEO, 'public', 'music')

const ENDPOINT = 'https://openrouter.ai/api/v1/chat/completions'
const DEFAULT_MODEL = 'google/lyria-3-pro-preview'
const DEFAULT_PROMPT = join(VIDEO, 'music', 'prompt.txt')
/** Read off `GET /api/v1/models` on 2026-10-14: a flat price per piece, not per token. */
const PRICE_PER_PIECE: Record<string, number> = {
  'google/lyria-3-pro-preview': 0.08,
  'google/lyria-3-clip-preview': 0.04,
}

function fail(sentence: string): never {
  console.error(`\n${sentence}\n`)
  process.exit(1)
}

const shown = (path: string) => {
  const r = relative(process.cwd(), path)
  return r === '' ? '.' : r.startsWith('..') ? path : r
}

/** Seconds of audio, measured; the licence and the fit against the edit are written from this. */
function measureSeconds(path: string): number {
  const r = spawnSync('ffprobe', ['-v', 'error', '-show_entries', 'format=duration', '-of', 'json', path], { encoding: 'utf8' })
  if (r.error) fail('ffprobe is not installed, and the track cannot be measured without it; install ffmpeg and run again.')
  const seconds = Number((JSON.parse(r.stdout || '{}') as { format?: { duration?: string } }).format?.duration)
  if (!(seconds > 0)) fail(`${shown(path)} is not playable audio.`)
  return seconds
}

// --- one generation ------------------------------------------------------------

type Generated = { audio: Buffer; id: string | null; cost: number | null; text: string }

async function generate(key: string, model: string, prompt: string): Promise<Generated> {
  let res: Response
  try {
    res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model,
        stream: true,
        modalities: ['text', 'audio'],
        audio: { format: 'mp3' },
        messages: [{ role: 'user', content: prompt }],
      }),
      signal: AbortSignal.timeout(600_000),
    })
  } catch {
    fail('OpenRouter could not be reached; check the connection and run again.')
  }
  if (res.status === 401) fail('OpenRouter refused the key; check OPENROUTER_API_KEY.')
  if (res.status === 402) fail('The OpenRouter account is out of credits; add credits and run again.')
  if (!res.ok || !res.body) fail(`OpenRouter would not generate music with ${model}: ${await providerMessage(res)}`)

  // Server-sent events: one JSON chunk per `data:` line, the audio base64 across many of them.
  const chunks: string[] = []
  let text = ''
  let id: string | null = null
  let cost: number | null = null
  let buffer = ''
  const decoder = new TextDecoder()
  for await (const part of res.body as unknown as AsyncIterable<Uint8Array>) {
    buffer += decoder.decode(part, { stream: true })
    let nl: number
    while ((nl = buffer.indexOf('\n')) >= 0) {
      const line = buffer.slice(0, nl).trim()
      buffer = buffer.slice(nl + 1)
      if (!line.startsWith('data: ') || line === 'data: [DONE]') continue
      let j: {
        id?: string
        usage?: { cost?: number }
        error?: { message?: string }
        choices?: { delta?: { content?: string; audio?: { data?: string } } }[]
      }
      try {
        j = JSON.parse(line.slice(6))
      } catch {
        continue
      }
      if (j.error?.message) fail(`OpenRouter stopped the generation: ${j.error.message}`)
      id = j.id ?? id
      if (typeof j.usage?.cost === 'number') cost = j.usage.cost
      for (const c of j.choices ?? []) {
        if (c.delta?.content) text += c.delta.content
        if (c.delta?.audio?.data) chunks.push(c.delta.audio.data)
      }
    }
  }
  const audio = Buffer.from(chunks.join(''), 'base64')
  if (audio.length === 0) fail(`OpenRouter answered without audio${text ? `: ${text.replace(/\s+/g, ' ').slice(0, 240)}` : ''}.`)
  return { audio, id, cost, text }
}

// --- install -----------------------------------------------------------------------

/** The track in use, and the note that says where it came from. */
function install(file: string, provenance: string) {
  const seconds = measureSeconds(file)
  const film = resolvePlan(CUT, [], false).seconds
  mkdirSync(PUBLIC_MUSIC, { recursive: true })
  copyFileSync(file, join(PUBLIC_MUSIC, 'track.mp3'))
  writeFileSync(
    join(PUBLIC_MUSIC, 'LICENSE.txt'),
    `Ink Desk demo music — track.mp3

${provenance}

Generated for this project and used as its background music under the
generating service's terms for generated content; it is not a recording or a
composition by any third party. The render fades it in, ducks it under the
voice and fades it out (video/src/mix.ts). Generate another with
\`npm run video:music:generate\`, or compose one in code with
\`npm run video:music\`.
`,
  )
  console.log(`Installed ${shown(file)} as ${shown(join(PUBLIC_MUSIC, 'track.mp3'))} (${seconds.toFixed(1)} s) with its LICENSE.txt`)
  if (seconds < film - 3) {
    console.log(`Note: the track is ${seconds.toFixed(1)} s and the film is ${film.toFixed(1)} s — the music ends ${(film - seconds).toFixed(1)} s before the picture does. Ask for a longer piece in the prompt, or let the outro end in silence.`)
  }
}

// --- the command line ------------------------------------------------------------------

async function main() {
  let values: { model?: string; prompt?: string; install?: string; 'dry-run'?: boolean }
  try {
    ;({ values } = parseArgs({
      args: process.argv.slice(2),
      options: {
        model: { type: 'string' },
        prompt: { type: 'string' },
        install: { type: 'string' },
        'dry-run': { type: 'boolean' },
      },
    }))
  } catch (err) {
    fail(`${(err as Error).message.replace(/\s+/g, ' ')} Usage: npx tsx music/generate.mts [--model <id>] [--prompt <file>] [--dry-run], or --install <mp3>.`)
  }

  if (values.install) {
    const file = join(process.cwd(), values.install)
    if (!existsSync(file)) fail(`There is no file at ${shown(file)}.`)
    const note = join(dirname(file), `${basename(file, '.mp3')}.txt`)
    install(file, existsSync(note) ? readFileSync(note, 'utf8').trim() : `Installed from ${basename(file)} on ${new Date().toISOString().slice(0, 10)}; its origin was not recorded.`)
    return
  }

  const model = values.model?.trim() || DEFAULT_MODEL
  const promptPath = values.prompt ? join(process.cwd(), values.prompt) : DEFAULT_PROMPT
  if (!existsSync(promptPath)) fail(`There is no prompt at ${shown(promptPath)}.`)
  const prompt = readFileSync(promptPath, 'utf8').trim()
  if (!prompt) fail(`${shown(promptPath)} is empty — describe the music's mood in it.`)
  const price = PRICE_PER_PIECE[model]
  console.log(`Generating music with ${model} from ${shown(promptPath)} (${prompt.length} chars) ≈ ${price === undefined ? 'price unknown' : `$${price.toFixed(2)}`}${values['dry-run'] ? ' (dry run: nothing is sent)' : ''}`)
  if (values['dry-run']) return

  const key = apiKey()
  if (!key) fail(MISSING_KEY)
  const started = Date.now()
  const { audio, id, cost, text } = await generate(key, model, prompt)
  mkdirSync(OUT, { recursive: true })
  const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')
  const file = join(OUT, `${model.split('/').pop()}-${stamp}.mp3`)
  writeFileSync(file, audio)
  const seconds = measureSeconds(file)
  const provenance = `Generated on ${stamp.slice(0, 10)} by ${model} through OpenRouter (generation ${id ?? 'not reported'}), from the prompt in video/music/prompt.txt (sha256 ${createHash('sha256').update(prompt).digest('hex').slice(0, 16)}); ${seconds.toFixed(1)} s.`
  writeFileSync(join(OUT, `${basename(file, '.mp3')}.txt`), `${provenance}\n`)
  console.log(`  ${shown(file)}   ${seconds.toFixed(1)} s   ${cost === null ? 'cost not reported' : `$${cost.toFixed(2)}`}   ${((Date.now() - started) / 1000).toFixed(0)} s${text.trim() ? `   (${text.replace(/\s+/g, ' ').trim().slice(0, 80)})` : ''}`)
  install(file, provenance)
}

main().catch((err) => fail(`The generation stopped unexpectedly: ${(err as Error).message}`))
